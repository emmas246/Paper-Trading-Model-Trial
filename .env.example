# Copy this file to .env and fill in your real keys. Never commit .env to git.

# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here

# Get from https://app.alpaca.markets/ (use PAPER trading keys, not live, until you trust the system)
ALPACA_API_KEY=your_alpaca_paper_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
